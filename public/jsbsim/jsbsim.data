  <flight_control name="A320 surfaces (laws are in the flight control computer)">
    <channel name="Pitch">
      <summer name="Pitch trim sum">
        <input>fcs/elevator-cmd-norm</input>
        <input>fcs/pitch-trim-cmd-norm</input>
        <clipto> <min>-1</min> <max>1</max> </clipto>
      </summer>
      <aerosurface_scale name="Elevator">
        <input>fcs/pitch-trim-sum</input>
        <range> <min>-0.5236</min> <max>0.5236</max> </range>
        <output>fcs/elevator-pos-rad</output>
      </aerosurface_scale>
    </channel>
    <channel name="Roll">
      <aerosurface_scale name="Left aileron">
        <input>fcs/aileron-cmd-norm</input>
        <range> <min>-0.4363</min> <max>0.4363</max> </range>
        <output>fcs/left-aileron-pos-rad</output>
      </aerosurface_scale>
      <aerosurface_scale name="Right aileron">
        <input>-fcs/aileron-cmd-norm</input>
        <range> <min>-0.4363</min> <max>0.4363</max> </range>
        <output>fcs/right-aileron-pos-rad</output>
      </aerosurface_scale>
    </channel>
    <channel name="Yaw">
      <aerosurface_scale name="Rudder">
        <input>fcs/rudder-cmd-norm</input>
        <range> <min>-0.5236</min> <max>0.5236</max> </range>
        <output>fcs/rudder-pos-rad</output>
      </aerosurface_scale>
    </channel>
    <channel name="High lift">
      <kinematic name="Slats and flaps">
        <input>fcs/flap-cmd-norm</input>
        <traverse>
          <setting> <position> 0 </position> <time> 0 </time> </setting>
          <setting> <position> 1 </position> <time> 7 </time> </setting>
          <setting> <position> 2 </position> <time> 6 </time> </setting>
          <setting> <position> 3 </position> <time> 5 </time> </setting>
          <setting> <position> 4 </position> <time> 7 </time> </setting>
        </traverse>
        <output>fcs/conf-pos</output>
      </kinematic>
      <fcs_function name="Flap angle">
        <function><table> <independentVar>fcs/conf-pos</independentVar> <tableData>
          0 0
          1 10
          2 15
          3 20
          4 35
        </tableData> </table></function>
        <output>fcs/flap-pos-deg</output>
      </fcs_function>
      <fcs_function name="Slat angle">
        <function><table> <independentVar>fcs/conf-pos</independentVar> <tableData>
          0 0
          1 18
          2 22
          3 22
          4 27
        </tableData> </table></function>
        <output>fcs/slat-pos-deg</output>
      </fcs_function>
    </channel>
    <channel name="Gear and spoilers">
      <kinematic name="Gear">
        <input>gear/gear-cmd-norm</input>
        <traverse>
          <setting> <position> 0 </position> <time> 0 </time> </setting>
          <setting> <position> 1 </position> <time> 10 </time> </setting>
        </traverse>
        <output>gear/gear-pos-norm</output>
      </kinematic>
      <kinematic name="Speedbrakes">
        <input>fcs/speedbrake-cmd-norm</input>
        <traverse>
          <setting> <position> 0 </position> <time> 0 </time> </setting>
          <setting> <position> 1 </position> <time> 2 </time> </setting>
        </traverse>
        <output>fcs/speedbrake-pos-norm</output>
      </kinematic>
      <kinematic name="Ground spoilers">
        <input>fcs/spoiler-cmd-norm</input>
        <traverse>
          <setting> <position> 0 </position> <time> 0 </time> </setting>
          <setting> <position> 1 </position> <time> 1 </time> </setting>
        </traverse>
        <output>fcs/spoiler-pos-norm</output>
      </kinematic>
    </channel>
  </flight_control>

